<?xml version="1.0" ?>
<sdf version="1.7">
<world name="duckietown_world">

  <!-- LUMIERE -->
  <light name="sun" type="directional">
    <direction>-0.5 0.5 -1</direction>
    <diffuse>1 1 1 1</diffuse>
  </light>

  <!-- SOL 5x5 -->
  <model name="ground">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane><size>5 5</size></plane>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <plane><size>5 5</size></plane>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
        </material>
      </visual>
    </link>
  </model>

  <!-- ========================= -->
  <!-- ROUTE OVALE (ELLIPSE) -->
  <!-- ========================= -->

  <!-- extérieur -->
  <model name="road_outer">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>2.0</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
        </material>
      </visual>
    </link>
    <pose>0 0 0.01 0 0 0</pose>
  </model>

  <!-- intérieur -->
  <model name="road_inner">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>1.6</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
        </material>
      </visual>
    </link>
    <pose>0 0 0.015 0 0 0</pose>
  </model>


  <!-- ========================= -->
  <!-- BORDURES BLANCHES -->
  <!-- ========================= -->

  <model name="border_outer">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>2.05</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
        </material>
      </visual>
    </link>
    <pose>0 0 0.02 0 0 0</pose>
  </model>

  <model name="border_inner">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>1.55</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
        </material>
      </visual>
    </link>
    <pose>0 0 0.02 0 0 0</pose>
  </model>

</world>
</sdf>